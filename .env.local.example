### Example env vars for optional Airtable integration (leave blank to use Local Storage)
VITE_AIRTABLE_API_KEY=your_airtable_api_key_here
VITE_AIRTABLE_BASE_ID=your_airtable_base_id_here
VITE_AIRTABLE_TABLE_NAME=your_airtable_table_name_here

### Example: development toggles
# Set to "true" to enable debug modes (not required for normal operation)
VITE_DEBUG=false
